{
  "name": "opendds-performance-dashboard",
  "version": "0.2.0",
  "description": "OpenDSS Performance Dashboard UI",
  "scripts": {
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite",
    "format": "prettier --write '{public,src}/**/*.{css,html,js,svelte,ts}'",
    "lint": "eslint --fix --quiet src --ext .js,.svelte,.ts",
    "lint:check": "eslint --quiet src --ext .js,.svelte,.ts",
    "reinstall": "rm -rf package-lock.json node_modules; npm install",
    "serve": "vite preview",
    "test": "jest",
    "test:watch": "npm run all -- --watch"
  },
  "contributors": [
    "R. Mark Volkmann",
    "Eldon Ahrold",
    "Timothy Simpson"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenDDS/opendds-performance-dashboard.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "acorn": "^8.16.0",
    "autoprefixer": "^10.5.0",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-svelte": "^3.19.0",
    "jest": "^30.4.2",
    "postcss": "^8.5.23",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "stylelint": "^17.13.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "svelte-preprocess": "^6.0.5",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "webpack": "^5.107.2"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
