{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenDDS Bench Run Index",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["key", "date", "commit", "errors"],
    "properties": {
      "key": {"type": "string", "minLength": 1},
      "date": {"type": "string", "minLength": 1},
      "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
      "hash": {"type": "string"},
      "errors": {"type": "integer", "minimum": 0},
      "era": {"type": "string"},
      "suite": {"type": "string"},
      "status": {"enum": ["QUEUED", "PROVISIONING", "RUNNING", "SUCCEEDED", "FAILED", "TIMED_OUT"]},
      "topology": {
        "type": "object",
        "required": ["legCount", "coresPerLeg"],
        "properties": {
          "legCount": {"type": "integer", "minimum": 1, "maximum": 99},
          "coresPerLeg": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": true
  }
}
